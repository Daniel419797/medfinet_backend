{
  "name": "algorand--backend",
  "version": "1.0.0",
  "description": "Algorand Smart Contract Crowdfunding Platform",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon app.js",
    "build": "prisma generate && node scripts/check-syntax.js",
    "nfc:cleanup": "node scripts/cleanup-nfc.js",
    "nfc:verify:integration": "node scripts/verify-nfc-integration.js",
    "nfc:verify:http": "node scripts/verify-nfc-http-integration.js",
    "ussd:cleanup": "node scripts/cleanup-ussd.js",
    "ussd:ingress": "node gateway/ussdIngress.js",
    "ussd:verify:integration": "node scripts/verify-ussd-integration.js",
    "start": "node app.js",
    "start:production": "prisma migrate deploy && node app.js",
    "test": "node --test test/**/*.test.js",
    "check": "node scripts/check-syntax.js",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "compile:contracts": "node contracts/compile.js",
    "worker": "node scripts/process-outbox.js",
    "worker:once": "node scripts/process-outbox.js --once"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "^9.1.1",
    "@prisma/client": "^5.0.0",
    "@supabase/supabase-js": "^2.81.1",
    "algosdk": "^3.5.2",
    "axios": "^1.10.0",
    "bcryptjs": "^2.4.0",
    "body-parser": "^2.2.0",
    "cors": "^2.8.0",
    "crypto": "^1.0.1",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "form-data": "^4.0.3",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "puppeteer": "^24.11.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/morgan": "^1.9.0",
    "@types/node": "^20.0.0",
    "nodemon": "^3.0.0",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
