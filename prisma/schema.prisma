// ─── Marketplace / Facility Registry ─────────────────────────────────────────

model Hospital {
  id              String   @id @default(cuid())
  name            String
  type            String   @default("")
  email           String   @unique
  phone           String
  website         String   @default("")
  establishedYear Int?
  bedCount        Int      @default(0)
  specialties     Json
  street          String   @default("")
  city            String   @default("")
  state           String   @default("")
  zipCode         String   @default("")
  country         String   @default("Nigeria")
  adminName       String   @default("")
  adminEmail      String   @default("")
  adminPhone      String   @default("")
  adminTitle      String   @default("")
  walletAddress   String   @unique
  status          String   @default("pending")
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@map("hospitals")
}

model HealthWorker {
  id                 String   @id @default(cuid())
  firstName          String
  lastName           String
  email              String   @unique
  phone              String   @default("")
  walletAddress      String   @unique
  facilityName       String   @default("")
  facilityType       String   @default("")
  licenseNumber      String   @default("")
  specialization     String   @default("")
  professionalRole   String   @default("")
  verificationStatus String   @default("pending")
  status             String   @default("active")
  createdAt          DateTime @default(now())

  @@map("health_workers")
}

model TelemedicineDoctor {
  id            String   @id @default(cuid())
  name          String
  specialty     String
  rating        Float    @default(0)
  experience    Int      @default(0)
  avatar        String   @default("")
  available     Boolean  @default(true)
  price         Float
  nextAvailable DateTime?

  consultations TelemedicineConsultation[]

  @@map("telemedicine_doctors")
}

model TelemedicineConsultation {
  id          String              @id @default(cuid())
  doctorId    String
  patientId   String
  type        String
  scheduledAt DateTime
  status      String              @default("scheduled")
  price       Float
  notes       String              @default("")
  createdAt   DateTime            @default(now())

  doctor TelemedicineDoctor @relation(fields: [doctorId], references: [id])

  @@map("telemedicine_consultations")
}

model InsurancePolicy {
  id              String   @id @default(cuid())
  policyNumber    String   @unique
  provider        String
  type            String
  status          String   @default("active")
  startDate       String
  endDate         String
  premium         Float
  frequency       String
  coverage        Json
  benefits        Json
  documents       Json
  nextPaymentDate String   @default("")
  createdAt       DateTime @default(now())

  claims   InsuranceClaim[]
  payments InsurancePayment[]

  @@map("insurance_policies")
}

model InsuranceClaim {
  id             String   @id @default(cuid())
  policyId       String
  claimNumber    String   @unique
  patientName    String
  serviceDate    String
  provider       String
  service        String
  amount         Float
  status         String   @default("submitted")
  submissionDate String
  documents      Json
  notes          String   @default("")
  createdAt      DateTime @default(now())

  policy InsurancePolicy @relation(fields: [policyId], references: [id])

  @@map("insurance_claims")
}

model InsurancePayment {
  id          String   @id @default(cuid())
  policyId    String
