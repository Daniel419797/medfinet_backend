// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  wallet    String   @unique
  createdAt DateTime @default(now())

  campaigns Campaign[]
  donations Donation[]

  @@map("users")
}

model Campaign {
  id              String               @id @default(cuid())
  title           String
  description     String
  targetAmount    Float
  raisedAmount    Float                @default(0)
  currency        String               @default("ALGO")
  category        String
  status          CampaignStatus       @default(PENDING)
  creatorId       String
  creatorWallet   String
  escrowAddress   String?              @unique
  appId           Int?                 @unique // Algorand Application ID
  createdAt       DateTime             @default(now())
  endDate         DateTime
  impactGoal      String
  imageUrl        String?
  withdrawnAmount Float?
  withdrawnAt     DateTime?
  withdrawals     CampaignWithdrawal[]

  creator       User             @relation(fields: [creatorId], references: [id])
  donations     Donation[]
  updates       CampaignUpdate[]
  escrowPayouts EscrowPayout[]

  @@map("campaigns")
}

model Donation {
  id              String         @id @default(cuid())
  amount          Float
  currency        String
  donorId         String?
  donorWallet     String
  campaignId      String
  transactionHash String?        @unique
  status          DonationStatus @default(PENDING)
  createdAt       DateTime       @default(now())
  confirmedAt     DateTime?

  donor    User?    @relation(fields: [donorId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@map("donations")
}

model CampaignUpdate {
  id         String   @id @default(cuid())
  title      String
  content    String
  campaignId String
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])
}

model EscrowPayout {
  id              String       @id @default(cuid())
  campaignId      String
  amount          Float
  transactionHash String       @unique
  status          PayoutStatus @default(PENDING)
  createdAt       DateTime     @default(now())
  processedAt     DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@map("escrow_payouts")
}

enum CampaignStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED
}

enum DonationStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSED
  FAILED
}

model CampaignWithdrawal {
  id                  String           @id @default(cuid())
  campaignId          String
  amount              Float
  recipientWallet     String
  transactionHash     String?
  unsignedTransaction String? // Store the unsigned transaction for signing
  status              WithdrawalStatus @default(PENDING_SIGNATURE)
  createdAt           DateTime         @default(now())
  completedAt         DateTime?

  // Relations
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("campaign_withdrawals")
}

enum WithdrawalStatus {
  PENDING_SIGNATURE
  PENDING_CONFIRMATION
  COMPLETED
  FAILED
}

model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @db.Timestamptz(3)

  memberships              OrganizationMembership[]
  facilities               Facility[]
  programmes               Programme[]
  caregivers               Caregiver[]
  children                 Child[]
  auditEvents              AuditEvent[]
  credentials              ChildCredential[]
  immunizations            ImmunizationRecord[]
  growthMeasurements       GrowthMeasurement[]
  clinicalAlerts           ClinicalAlert[]
  allergies                AllergyRecord[]
  appointments             Appointment[]
  consentGrants            ConsentGrant[]
  consentScopes            ConsentScope[]
  disclosureEvents         DisclosureEvent[]
  emergencyAccesses        EmergencyAccess[]
  climateProfiles          ClimateProfile[]
  climateEvents            ClimateEvent[]
  affectedAreas            AffectedArea[]
  worklists                BeneficiaryWorklist[]
  worklistEntries          WorklistEntry[]
  serviceDeliveries        ServiceDelivery[]
  referrals                Referral[]
  devices                  FieldDevice[]
  syncBatches              SyncBatch[]
  syncOperations           SyncOperation[]
  outboxEvents             OutboxEvent[]
  rewardCampaigns          RewardCampaign[]
  rewardAccounts           RewardAccount[]
  rewardTransactions       RewardTransaction[]
  rewardLedgerEntries      RewardLedgerEntry[]
  rewardGrants             RewardGrant[]
  merchants                Merchant[]
  rewardReservations       RewardReservation[]
  redemptions              RewardRedemption[]
  settlementBatches        SettlementBatch[]
  merchantMemberships      MerchantMembership[]
  notificationPreferences  NotificationPreference[]
  notificationTemplates    NotificationTemplate[]
  notificationMessages     NotificationMessage[]
  notificationAttempts     NotificationDeliveryAttempt[]
  integrationConnections   IntegrationConnection[]
  integrationMappings      IntegrationMapping[]
  integrationJobs          IntegrationJob[]
  integrationRecords       IntegrationExchangeRecord[]
  reconciliationRuns       IntegrationReconciliationRun[]
  integrationImportStaging IntegrationImportStaging[]
  analyticsPolicy          AnalyticsPublicationPolicy?
  analyticsRuns            AnalyticsGenerationRun[]
  aggregateMetrics         AggregateMetricSnapshot[]
  retentionPolicies        DataRetentionPolicy[]
  retentionRuns            RetentionExecutionRun[]
  legalHolds               LegalHold[]
  dataSubjectRequests      DataSubjectRequest[]
  localizationContent      LocalizationContent[]
  vaccineScheduleRules     VaccineScheduleRule[]
  ussdSessions             UssdSession[]
  ussdPhoneRoutes          UssdPhoneRoute[]
  ussdFacilityDirectory    UssdFacilityDirectory[]
  ussdOtpChallenges        UssdOtpChallenge[]
  appointmentResponses     AppointmentCaregiverResponse[]
  ussdCallbackRequests     UssdCallbackRequest[]
  nfcCardSupportRequests   NfcCardSupportRequest[]
  ussdConsentRequests      UssdConsentRequest[]
  programmeInterests       ProgrammeInterest[]
  deliveryConfirmations    ServiceDeliveryConfirmation[]
  redemptionConfirmations RewardRedemptionConfirmation[]
  climateAssistanceRequests ClimateAssistanceRequest[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String              @id @default(cuid())
  organizationId String
  subjectId      String
  role           OrganizationRole
  status         MembershipStatus    @default(ACTIVE)
  scopeMode      MembershipScopeMode @default(GLOBAL)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)

  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facilityScopes  MembershipFacilityScope[]
  programmeScopes MembershipProgrammeScope[]

  @@unique([organizationId, subjectId])
  @@unique([id, organizationId])
  @@index([subjectId, status])
  @@map("organization_memberships")
}

model Facility {
  id                 String   @id @default(cuid())
  organizationId     String
  name               String
  code               String
  administrativeArea String?
  address             String?
  phone               String?
  openingHours        Json?
  programmeCategories Json?
  latitude            Decimal? @db.Decimal(9, 6)
  longitude           Decimal? @db.Decimal(9, 6)
  isTemporary         Boolean  @default(false)
  temporaryUntil      DateTime? @db.Timestamptz(3)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  immunizations      ImmunizationRecord[]
  growthMeasurements GrowthMeasurement[]
  appointments       Appointment[]
  membershipScopes   MembershipFacilityScope[]
  ussdDirectory      UssdFacilityDirectory?

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("facilities")
}

model Programme {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  code           String
  isActive       Boolean   @default(true)
  startsAt       DateTime? @db.Timestamptz(3)
  endsAt         DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  organization         Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  immunizations        ImmunizationRecord[]
  worklists            BeneficiaryWorklist[]
  rewardCampaigns      RewardCampaign[]
  membershipScopes     MembershipProgrammeScope[]
  vaccineScheduleRules VaccineScheduleRule[]
  interests            ProgrammeInterest[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("programmes")
}

model MembershipFacilityScope {
  id                  String   @id @default(cuid())
  organizationId      String
  membershipId        String
  facilityId          String
  assignedBySubjectId String
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  membership OrganizationMembership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  facility   Facility               @relation(fields: [facilityId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([membershipId, facilityId])
  @@index([organizationId, facilityId])
  @@map("membership_facility_scopes")
}

model MembershipProgrammeScope {
  id                  String   @id @default(cuid())
  organizationId      String
  membershipId        String
  programmeId         String
  assignedBySubjectId String
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  membership OrganizationMembership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  programme  Programme              @relation(fields: [programmeId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([membershipId, programmeId])
  @@index([organizationId, programmeId])
  @@map("membership_programme_scopes")
}

model Caregiver {
  id                 String   @id @default(cuid())
  organizationId     String
  firstName          String
  lastName           String
  preferredLanguage  String   @default("en")
  subjectId          String?
  phone              String?
  phoneNormalized    String?
  phoneVerifiedAt    DateTime? @db.Timestamptz(3)
  ussdPinHash        String?
  ussdPinFailedAttempts Int    @default(0)
  ussdPinLockedUntil DateTime? @db.Timestamptz(3)
  ussdPinChangedAt   DateTime? @db.Timestamptz(3)
  email              String?
  createdBySubjectId String
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  children             ChildCaregiver[]
  consentGrants        ConsentGrant[]
  rewardAccount        RewardAccount?
  notificationMessages NotificationMessage[]
  dataSubjectRequests  DataSubjectRequest[]
  ussdSessions         UssdSession[]
  ussdPhoneRoutes      UssdPhoneRoute[]
  ussdOtpChallenges    UssdOtpChallenge[]
  appointmentResponses AppointmentCaregiverResponse[]
  ussdCallbackRequests UssdCallbackRequest[]
  nfcCardSupportRequests NfcCardSupportRequest[]
  ussdConsentRequests  UssdConsentRequest[]
  programmeInterests   ProgrammeInterest[]
  deliveryConfirmations ServiceDeliveryConfirmation[]
  redemptionConfirmations RewardRedemptionConfirmation[]
  climateAssistanceRequests ClimateAssistanceRequest[]

  @@unique([id, organizationId])
  @@unique([organizationId, subjectId])
  @@unique([organizationId, phoneNormalized])
  @@index([organizationId, lastName, firstName])
  @@map("caregivers")
}

model Child {
  id                 String      @id @default(cuid())
  organizationId     String
  medfinetId         String      @unique
  firstName          String
  lastName           String
  dateOfBirth        DateTime    @db.Date
  sex                ChildSex
  status             ChildStatus @default(ACTIVE)
  createdBySubjectId String
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(3)

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  caregivers          ChildCaregiver[]
  credentials         ChildCredential[]
  immunizations       ImmunizationRecord[]
  growthMeasurements  GrowthMeasurement[]
  clinicalAlerts      ClinicalAlert[]
  allergies           AllergyRecord[]
  appointments        Appointment[]
  consentGrants       ConsentGrant[]
  disclosureEvents    DisclosureEvent[]
  emergencyAccesses   EmergencyAccess[]
  climateProfile      ClimateProfile?
  worklistEntries     WorklistEntry[]
  serviceDeliveries   ServiceDelivery[]
  referrals           Referral[]
  rewardGrants        RewardGrant[]
  legalHolds          LegalHold[]
  dataSubjectRequests DataSubjectRequest[]
  identityAmendments  ChildIdentityAmendment[]
  identifiers         ChildIdentifier[]
  appointmentResponses AppointmentCaregiverResponse[]
  ussdCallbackRequests UssdCallbackRequest[]
  nfcCardSupportRequests NfcCardSupportRequest[]
  ussdConsentRequests  UssdConsentRequest[]
  programmeInterests   ProgrammeInterest[]
  deliveryConfirmations ServiceDeliveryConfirmation[]
  climateAssistanceRequests ClimateAssistanceRequest[]

  @@unique([id, organizationId])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, dateOfBirth])
  @@map("children")
}

model ChildCaregiver {
  id                  String                @id @default(cuid())
  organizationId      String
  childId             String
  caregiverId         String
  relationship        CaregiverRelationship
  isPrimary           Boolean               @default(false)
  hasConsentAuthority Boolean               @default(false)
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)

  child     Child     @relation(fields: [childId, organizationId], references: [id, organizationId], onDelete: Cascade)
  caregiver Caregiver @relation(fields: [caregiverId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([childId, caregiverId])
  @@index([organizationId, childId])
  @@index([organizationId, caregiverId])
  @@map("child_caregivers")
}

model ChildIdentifier {
  id                    String                @id @default(cuid())
  organizationId        String
  childId               String
  system                String
  value                 String
  status                ChildIdentifierStatus @default(PENDING)
  isPrimary             Boolean               @default(false)
  evidenceReference     String?
  createdBySubjectId    String
  verifiedBySubjectId   String?
  verifiedAt            DateTime?             @db.Timestamptz(3)
  revokedBySubjectId    String?
  revokedAt             DateTime?             @db.Timestamptz(3)
  revocationReason      String?
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)

  child Child @relation(fields: [childId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@unique([organizationId, system, value])
  @@index([organizationId, childId, status])
  @@map("child_identifiers")
}

model ChildIdentityAmendment {
  id                    String                  @id @default(cuid())
  organizationId        String
  childId               String
  status                IdentityAmendmentStatus @default(PENDING)
  reason                String
  proposedData          Json
  previousData          Json?
  requestedBySubjectId  String
  requestedAt           DateTime                @default(now()) @db.Timestamptz(3)
  reviewedBySubjectId   String?
  reviewedAt            DateTime?               @db.Timestamptz(3)
  reviewReason          String?
  appliedAt             DateTime?               @db.Timestamptz(3)
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)

  child Child @relation(fields: [childId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@index([organizationId, childId, status, requestedAt])
  @@map("child_identity_amendments")
}

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String
  actorSubjectId String
  action         String
  entityType     String
  entityId       String
  purpose        String
  metadata       Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([actorSubjectId, createdAt])
  @@map("audit_events")
}

model ChildCredential {
  id                   String           @id @default(cuid())
  organizationId       String
  childId              String
  tokenHash            String           @unique
  kind                 CredentialKind
  status               CredentialStatus @default(ACTIVE)
  issuedBySubjectId    String
  expiresAt            DateTime?        @db.Timestamptz(3)
  revokedAt            DateTime?        @db.Timestamptz(3)
  revokedReason        String?
  replacesCredentialId String?
  lastScannedAt        DateTime?        @db.Timestamptz(3)
  createdAt            DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  child        Child             @relation(fields: [childId, organizationId], references: [id, organizationId], onDelete: Cascade)
  scans        CredentialScan[]
  replaces     ChildCredential?  @relation("CredentialReplacement", fields: [replacesCredentialId, organizationId], references: [id, organizationId], onDelete: Restrict)
  replacements ChildCredential[] @relation("CredentialReplacement")
  nfcBinding   NfcCredentialBinding?
  cardSupportRequests NfcCardSupportRequest[]

  @@unique([id, organizationId])
  @@unique([replacesCredentialId, organizationId])
  @@index([organizationId, childId, status])
  @@map("child_credentials")
}

model NfcCredentialBinding {
  id                       String           @id @default(cuid())
  organizationId           String
  credentialId             String
  publicId                 String           @unique
  hardwareFamily           String           @default("NTAG_215")
  status                   NfcBindingStatus @default(PENDING)
  uidHash                  String?
  personalizationNonceHash String
  provisioningExpiresAt    DateTime         @db.Timestamptz(3)
  lastCounter              Int              @default(-1)
  originalitySignatureHash String?
  originalityVerifiedAt    DateTime?        @db.Timestamptz(3)
  preparedAt                DateTime?        @db.Timestamptz(3)
  preparedBySubjectId       String?
  writeProtectedAt         DateTime?        @db.Timestamptz(3)
  configurationLockedAt    DateTime?        @db.Timestamptz(3)
  activatedAt              DateTime?        @db.Timestamptz(3)
  activatedBySubjectId     String?
  failedAt                 DateTime?        @db.Timestamptz(3)
  failureReason            String?
  createdAt                DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime         @updatedAt @db.Timestamptz(3)

  credential ChildCredential @relation(fields: [credentialId, organizationId], references: [id, organizationId], onDelete: Restrict)
  scanChallenges NfcScanChallenge[]

  @@unique([id, organizationId])
  @@unique([credentialId, organizationId])
  @@unique([organizationId, uidHash])
  @@index([organizationId, status, createdAt])
  @@map("nfc_credential_bindings")
}

model NfcPublicRoute {
  publicId       String   @id
  organizationId String
  bindingId      String   @unique
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@map("nfc_public_routes")
}

model NfcScanChallenge {
  id             String        @id @default(cuid())
  organizationId String
  bindingId      String
  tokenHash      String        @unique
  actorSubjectId String
  deviceId       String
  status         NfcChallengeStatus @default(PENDING)
  expiresAt      DateTime      @db.Timestamptz(3)
  consumedAt     DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  binding NfcCredentialBinding @relation(fields: [bindingId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@index([organizationId, status, expiresAt])
  @@map("nfc_scan_challenges")
}

model CredentialScan {
  id             String   @id @default(cuid())
  organizationId String
  credentialId   String
  actorSubjectId String
  purpose        String
  outcome        String
  deviceId       String?
  scannedAt      DateTime @default(now()) @db.Timestamptz(3)

  credential ChildCredential @relation(fields: [credentialId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, credentialId, scannedAt])
  @@map("credential_scans")
}

model ImmunizationRecord {
  id                     String               @id @default(cuid())
  organizationId         String
  childId                String
  facilityId             String?
  programmeId            String?
  vaccineCode            String
  doseNumber             Int
  administeredAt         DateTime             @db.Timestamptz(3)
  lotNumber              String?
  route                  String?
  site                   String?
  notes                  String?
  sourceOperationId      String?
  deduplicationKey       String?
  administeringSubjectId String
  status                 ClinicalRecordStatus @default(ACTIVE)
  createdAt              DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime             @updatedAt @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  child        Child               @relation(fields: [childId, organizationId], references: [id, organizationId], onDelete: Restrict)
  facility     Facility?           @relation(fields: [facilityId, organizationId], references: [id, organizationId], onDelete: Restrict)
  programme    Programme?          @relation(fields: [programmeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  amendments   ClinicalAmendment[]

  @@unique([organizationId, sourceOperationId])
  @@unique([organizationId, deduplicationKey])
  @@unique([id, organizationId])
  @@index([organizationId, childId, administeredAt])
  @@map("immunization_records")
}

model GrowthMeasurement {
  id                   String               @id @default(cuid())
  organizationId       String
  childId              String
  facilityId           String?
  measuredAt           DateTime             @db.Timestamptz(3)
  weightGrams          Int?
  heightMillimeters    Int?
  muacMillimeters      Int?
  vitaminAAdministered Boolean              @default(false)
  oedemaPresent        Boolean              @default(false)
  notes                String?
  sourceOperationId    String?
  recordedBySubjectId  String
  status               ClinicalRecordStatus @default(ACTIVE)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  child        Child               @relation(fields: [childId, organizationId], references: [id, organizationId], onDelete: Restrict)
  facility     Facility?           @relation(fields: [facilityId, organizationId], references: [id, organizationId], onDelete: Restrict)
  amendments   ClinicalAmendment[]

  @@unique([id, organizationId])
  @@unique([organizationId, sourceOperationId])
  @@index([organizationId, childId, measuredAt])
  @@map("growth_measurements")
}

model ClinicalAlert {
  id                  String        @id @default(cuid())
  organizationId      String
  childId             String
  category            String
  severity            AlertSeverity
  summary             String
  emergencyVisible    Boolean       @default(false)
  status              AlertStatus   @default(ACTIVE)
  createdBySubjectId  String
  resolvedBySubjectId String?
  resolvedAt          DateTime?     @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, childId, status])
  @@map("clinical_alerts")
}

model AllergyRecord {
  id                  String             @id @default(cuid())
  organizationId      String
  childId             String
  substanceCode       String?
  substanceDisplay    String
  reaction            String?
  severity            AlertSeverity
  criticality         AllergyCriticality
  status              AllergyStatus      @default(ACTIVE)
  recordedBySubjectId String
  resolvedBySubjectId String?
  resolvedAt          DateTime?          @db.Timestamptz(3)
  resolutionReason    String?
  sourceOperationId   String?
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  child        Child        @relation(fields: [childId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@unique([organizationId, sourceOperationId])
  @@index([organizationId, childId, status])
  @@map("allergy_records")
}

model VaccineScheduleRule {
  id                  String             @id @default(cuid())
  organizationId      String
  programmeId         String?
  vaccineCode         String
  doseNumber          Int
  minimumAgeDays      Int
  recommendedAgeDays  Int
  maximumAgeDays      Int?
  minimumIntervalDays Int?
  version             Int
  status              ClinicalRuleStatus @default(DRAFT)
  createdBySubjectId  String
  approvedBySubjectId String?
  approvedAt          DateTime?          @db.Timestamptz(3)
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
