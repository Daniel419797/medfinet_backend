NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000
REQUEST_BODY_LIMIT=1mb
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/medfinet
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=24h
AUTH_ALLOW_LEGACY_JWT=false
DEVICE_IDENTIFIER_PEPPER=replace-with-at-least-32-random-characters
REWARD_TOKEN_SECRET=replace-with-a-different-32-character-random-secret
RATE_LIMIT_KEY_PEPPER=replace-with-a-distinct-random-secret-at-least-32-characters
TRUST_PROXY_HOPS=1
NOTIFICATION_GATEWAY_URL=https://notifications.example.com/v1/messages
NOTIFICATION_GATEWAY_TOKEN=replace-with-notification-gateway-token
NOTIFICATION_WEBHOOK_SECRET=replace-with-a-32-character-webhook-signing-secret

# SMS delivery (optional). Leave SMS_PROVIDER empty to keep using NOTIFICATION_GATEWAY_URL.
# When set, SMS notifications and USSD OTPs are sent directly through BulkSMS Nigeria.
SMS_PROVIDER=
BULKSMS_NIGERIA_API_TOKEN=
BULKSMS_NIGERIA_SENDER_ID=MEDFINET
BULKSMS_NIGERIA_GATEWAY=direct-refund
# Defaults to the production endpoint in production and the sandbox endpoint elsewhere.
# BULKSMS_NIGERIA_BASE_URL=https://www.bulksmsnigeria.com/api/v2
# BULKSMS_NIGERIA_CALLBACK_URL=https://api.example.com/api/v1/webhooks/sms/bulksms-nigeria
# BULKSMS_NIGERIA_TIMEOUT_MS=10000
INTEGRATION_CREDENTIALS_JSON={}
INTEGRATION_ALLOWED_HOSTS=fhir.partner.example,dhis2.partner.example
INTEGRATION_PAYLOAD_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
NFC_TAP_BASE_URL=http://localhost:3000/nfc/tap
NFC_UID_PEPPER=replace-with-a-distinct-random-secret-at-least-32-characters
NFC_PROVISIONING_SECRET=replace-with-a-distinct-random-secret-at-least-32-characters
NFC_REQUIRE_ORIGINALITY_ATTESTATION=true
USSD_PROVIDER=africas_talking
USSD_WEBHOOK_SECRET=replace-with-a-distinct-random-secret-at-least-32-characters
USSD_PHONE_PEPPER=replace-with-a-distinct-random-secret-at-least-32-characters
USSD_PIN_PEPPER=replace-with-a-distinct-random-secret-at-least-32-characters
USSD_OTP_PEPPER=replace-with-a-distinct-random-secret-at-least-32-characters
USSD_STATE_ENCRYPTION_KEY=replace-with-a-base64-encoded-random-32-byte-key
USSD_PROVIDER_CALLBACK_TOKEN=replace-with-a-distinct-random-secret-at-least-32-characters
USSD_BACKEND_WEBHOOK_URL=https://api.example.com/api/v1/webhooks/ussd/africas-talking
USSD_INGRESS_PORT=3002
USSD_SESSION_TTL_SECONDS=180
USSD_OTP_TTL_SECONDS=300
USSD_MAX_RESPONSE_CHARACTERS=160

# Algorand. ALGORAND_ENABLED controls whether blockchain UI and APIs are available.
# The legacy unscoped endpoint values configure the default network and remain required
# by the base configuration loader. Network-specific values override them per selection.
ALGORAND_ENABLED=false
ALGORAND_DEFAULT_NETWORK=testnet
ALGORAND_ALLOWED_NETWORKS=testnet,mainnet
ALGORAND_ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGORAND_ALGOD_PORT=443
ALGORAND_ALGOD_TOKEN=
ALGORAND_EXPLORER_TRANSACTION_URL=https://testnet.explorer.perawallet.app/tx
ALGORAND_PLATFORM_WALLET_MNEMONIC=abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon water
ALGORAND_CONFIRMATION_ROUNDS=4
ALGORAND_FEE_MICROALGOS=1000
ALGORAND_REQUEST_TIMEOUT_MS=10000

# Optional per-network overrides. The public AlgoNode and Pera explorer endpoints below
# require no token. Use dedicated provider endpoints/tokens here if your deployment has them.
ALGORAND_TESTNET_ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGORAND_TESTNET_ALGOD_PORT=443
ALGORAND_TESTNET_ALGOD_TOKEN=
ALGORAND_TESTNET_EXPLORER_TRANSACTION_URL=https://testnet.explorer.perawallet.app/tx
ALGORAND_MAINNET_ALGOD_SERVER=https://mainnet-api.algonode.cloud
ALGORAND_MAINNET_ALGOD_PORT=443
ALGORAND_MAINNET_ALGOD_TOKEN=
ALGORAND_MAINNET_EXPLORER_TRANSACTION_URL=https://explorer.perawallet.app/tx

# AI features (parent assistant, USSD natural-language intake, narrative reports)
AI_ENABLED=false
AI_API_KEY=
AI_PROVIDER=auto
AI_MODEL=gpt-4o-mini
AI_BASE_URL=
AI_TIMEOUT_MS=20000
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.2

# Versioned deterministic risk-scoring policies. Defaults are used when omitted.
# Calibrate these values only from approved, human-reviewed pilot labels.
DUPLICATE_POLICY_VERSION=duplicate-risk-v1
DUPLICATE_LIKELY_THRESHOLD=0.8
DUPLICATE_POSSIBLE_THRESHOLD=0.5
DUPLICATE_NAME_WEIGHT=0.55
DUPLICATE_DOB_WEIGHT=0.35
DUPLICATE_SEX_WEIGHT=0.1
DUPLICATE_SWAPPED_NAME_PENALTY=0.95
DUPLICATE_SWAPPED_DATE_SCORE=0.75
DUPLICATE_NEAR_DATE_SCORE=0.6
DUPLICATE_NEAR_DATE_DAYS=1
# Add only aliases validated by local reviewers; do not infer ethnicity from a name.
DUPLICATE_NAME_ALIASES_JSON=[]

REWARD_ANOMALY_POLICY_VERSION=reward-risk-v1
REWARD_VELOCITY_THRESHOLD=3
REWARD_VELOCITY_WINDOW_HOURS=24
REWARD_AMOUNT_OUTLIER_Z_THRESHOLD=2.5
REWARD_MINIMUM_OUTLIER_PEERS=5
REWARD_MERCHANT_PRIOR_SAMPLES=20
REWARD_DISPERSION_FLOOR_RATIO=0.1
REWARD_SUSPICIOUS_SCORE_THRESHOLD=0.6
REWARD_VELOCITY_WEIGHT=0.6
REWARD_REUSED_REFERENCE_WEIGHT=0.5
REWARD_AMOUNT_OUTLIER_WEIGHT=0.5

CLIMATE_RISK_POLICY_VERSION=climate-worklist-risk-v1
CLIMATE_DISPLACED_BONUS=10
CLIMATE_STALE_ASSESSMENT_DAYS=180
CLIMATE_STALE_ASSESSMENT_BONUS=5
CLIMATE_MEDIUM_THRESHOLD=40
CLIMATE_HIGH_THRESHOLD=65
CLIMATE_CRITICAL_THRESHOLD=85
